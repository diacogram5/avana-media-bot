# Copy to .env and fill in real values. Never commit a real .env file.
# Values below are placeholders only.
BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE
OWNER_ID=PASTE_YOUR_TELEGRAM_NUMERIC_ID_HERE
DB_PATH=data/bot.db
BOT_LANGUAGE=fa
MAX_FILE_MB=50
DAILY_SEARCH_LIMIT=50
# ── Superior-intelligence layer + both speech directions (PRIMARY) ──
# OpenAI (the ChatGPT maker), one key for all three:
#  * Brain: understanding free text (song name / artist / lyric line)
#    and cleaning it into one search query (gpt-4o-mini).
#  * Voice-to-text: Whisper (whisper-1), Persian supported.
#  * Text-to-voice: TTS (tts-1), female -> nova, male -> onyx, for
#    Persian and English text alike.
# NOTE — "connect it to Muse": Muse is not available as an API this
# bot's code can call, so the practical equivalent is OpenAI, as above.
# Without this key the bot honestly says the superior intelligence /
# speech engine is not connected and never fakes an answer, audio or
# transcript. Basic rule-based search still works without it.
OPENAI_API_KEY=
# ── Audio identification ──
# Primary: Shazam signature (app/services/shazam_id.py) — NO token needed.
# It signs the audio of a sent film or a downloaded media file and looks
# it up against Shazam's catalogue. Note: this uses Shazam's unofficial
# endpoint via shazamio, so it can be rate-limited under heavy use.
# Fallback (only if set): AudD-style API with a token.
AUDD_API_TOKEN=
# ── Speech fallback (only if OPENAI_API_KEY is not set or fails) ──
# Persian TTS (Azure Speech). Voices: female fa-IR-DilaraNeural,
# male fa-IR-FaridNeural. Voice-to-text (speech recognition, fa-IR)
# reuses the same Azure Speech key/region. Without key+region, both
# directions honestly report "needs key" and never fake output.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Web admin panel (same DB as the bot, live edits, no restart needed).
# Set a long random token; the panel requires ?token=<WEB_ADMIN_TOKEN>.
WEB_ADMIN_ENABLED=1
WEB_ADMIN_PORT=8080
WEB_ADMIN_TOKEN=PASTE_A_LONG_RANDOM_PANEL_TOKEN_HERE
# ── New professional features (all optional, empty = off/hidden) ──
# Existing web version URL for the human-voice fallback button only.
# Leave empty and the button is hidden; never invent a URL here.
WEB_URL=
# Public bot ID/link, attached only to shared file captions / copy text.
BOT_ID=
# Public Telegram channels for the second (channel) engine, comma list.
CHANNEL_USERNAMES=
